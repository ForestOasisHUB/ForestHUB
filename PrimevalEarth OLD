local function GetAllMeatParts()
    local meatList = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = obj.Name:lower()
            if name:find("meat") or name:find("corpse") or name:find("food") or name:find("carcass") or name:find("flesh") or name:find("chunk") or name:find("item") or name:find("drop") or name:find("bone") or name:find("prey") or name:find("steak") or name:find("gibs") then
                local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                if targetPart then
                    table.insert(meatList, targetPart)
                end
            end
        end
    end
    return meatList
end

