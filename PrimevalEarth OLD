            end
        end)
        
        local currentTime = tick()
        local globalTargetHrp = GetNearestGlobalTarget()
        
        -- 1. XỬ LÝ LOGIC SINH TỒN (AUTO GRASS, AUTO MEAT ĐỨNG ĂN HẾT, AUTO DRINK)
        if AutoGrassActive then
            LockedWaterCFrame = nil
            currentTargetMeat = nil
            local targetPos = GrassPoints[grassIndex]
            if targetPos then
                hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                PressKeyE()

                if currentTime - grassTimer >= 5.0 then
                    grassIndex = grassIndex + 1
                    if grassIndex > #GrassPoints then grassIndex = 1 end
                    grassTimer = currentTime
                end
            end
            return
            
        elseif AutoMeatActive then
            LockedWaterCFrame = nil
            local allMeats = GetAllMeatParts()
            
            if currentTargetMeat then
                local isValid = false
                if currentTargetMeat.Parent and currentTargetMeat:IsA("BasePart") then
                    isValid = true
                elseif currentTargetMeat.Parent and currentTargetMeat:IsA("Model") then
                    isValid = true
                end
                if not isValid then
                    currentTargetMeat = nil
                end
            end
            
            if not currentTargetMeat then
                local nearestMeat = nil
                local shortestDist = math.huge
                for _, meat in ipairs(allMeats) do
                    local mPos = meat.Position or meat:GetPivot().Position
                    local dist = (hrp.Position - mPos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestMeat = meat
                    end
                end
                currentTargetMeat = nearestMeat
            end
            
            if currentTargetMeat then
                local meatPos = currentTargetMeat.Position or currentTargetMeat:GetPivot().Position
                hrp.CFrame = CFrame.new(meatPos + Vector3.new(0, 2, 0))
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                
                PressKeyE()
                for _, remote in ipairs(SurvivalRemotes) do
                    local name = remote.Name:lower()
                    if name:find("meat") or name:find("corpse") or name:find("feed") or name:find("food") then
                        remote:FireServer(currentTargetMeat)
                        remote:FireServer(currentTargetMeat.Parent)
                    end
                end
            else
                currentTargetMeat = nil
            end
            return
            
        elseif AutoDrinkActive then
            currentTargetMeat = nil
            local waterPos = WaterPoints[1]
            if waterPos then
                if not LockedWaterCFrame then
                    LockedWaterCFrame = CFrame.new(waterPos + Vector3.new(0, 2, 0))
                end
                
                hrp.CFrame = LockedWaterCFrame
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                
                local lookAtWaterCF = CFrame.new(Camera.CFrame.Position, waterPos)
                Camera.CFrame = Camera.CFrame:Lerp(lookAtWaterCF, 0.3)
                
                PressKeyE()
                ClickFixedScreenWater()
                
                for _, remote in ipairs(SurvivalRemotes) do
                    local name = remote.Name:lower()
                    if name:find("water") or name:find("drink") then
                        remote:FireServer()
                    end
                end
            end
            return
        else
            LockedWaterCFrame = nil
            currentTargetMeat = nil
        end

        -- AUTO AIM (KHÓA CHUẨN XÁC VÀO ĐẦU HOẶC THÂN MỤC TIÊU)
        if AutoAimActive and globalTargetHrp then
            pcall(function()
                local targetChar = globalTargetHrp.Parent
                if targetChar then
                    local targetPart = targetChar:FindFirstChild("Head") or globalTargetHrp
                    local targetPos = targetPart.Position
                    
                    local currentCamCF = Camera.CFrame
                    local targetLookCF = CFrame.new(currentCamCF.Position, targetPos)
                    Camera.CFrame = currentCamCF:Lerp(targetLookCF, 0.4)
                end
            end)
        end

        -- AUTO RUN
        if AutoRunActive and globalTargetHrp and not AutoKillActive and not AutoTargetKillActive then
            pcall(function()
                local rawDirection = (globalTargetHrp.Position - hrp.Position)
                local flatDir = Vector3.new(rawDirection.X, 0, rawDirection.Z)
                
                local localMoveDir = hrp.CFrame:VectorToObjectSpace(flatDir)
                if localMoveDir.Magnitude > 0.01 then
                    humanoid:Move(localMoveDir.Unit, true)
                else
                    humanoid:Move(Vector3.new(0, 0, -1), true)
                end
                
                local lookAtTarget = CFrame.new(hrp.Position, Vector3.new(globalTargetHrp.Position.X, hrp.Position.Y, globalTargetHrp.Position.Z))
                hrp.CFrame = hrp.CFrame:Lerp(lookAtTarget, 0.25)
            end)
        end

        -- AUTO ATTACK
        if AutoAttackActive and globalTargetHrp and not AutoKillActive and not AutoTargetKillActive then
            local dist = (hrp.Position - globalTargetHrp.Position).Magnitude
            if dist <= 25 then 
                PerformAttack(globalTargetHrp.Parent)
            end
        end
        
        -- ANTI SHAKE CAMERA
        if AntiShakeCameraActive and not AutoAimActive then
            local currentCamCF = Camera.CFrame
            if not LockedCameraPosition then
                LockedCameraPosition = currentCamCF
            else
                LockedCameraPosition = LockedCameraPosition:Lerp(currentCamCF, 0.15)
                Camera.CFrame = LockedCameraPosition
            end
        else
            LockedCameraPosition = nil
        end
        
        if IsAutoFarmRunning then
            local targetPos = FarmPoints[farmIndex]
            hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            
            if currentTime - farmTimer >= 10.5 then
                farmIndex = farmIndex + 1
                if farmIndex > #FarmPoints then farmIndex = 1 end
                farmTimer = currentTime
                UpdateFarmStatus()
            end
            return 
        end
        
        local myHealthPercent = humanoid.Health / humanoid.MaxHealth
        
        if EmergencyEscapeToggle and myHealthPercent <= 0.25 and myHealthPercent > 0 then
            CombatState = 2 
        elseif myHealthPercent >= 0.70 or not EmergencyEscapeToggle then
            CombatState = 1 
        end

        local targetHrp = nil
        if AutoTargetKillActive then
            targetHrp = GetSelectedPlayerTargetHRP()
        elseif AutoKillActive then
            targetHrp = GetTarget()
        else
            CurrentPersistentTarget = nil
        end
        
        if targetHrp and targetHrp.Parent then
            local targetChar = targetHrp.Parent
            local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
            
            if targetHum and targetHum.Health > 0 then
                if CombatState == 1 then
                    local targetVelocity = targetHrp.AssemblyLinearVelocity or Vector3.new(0,0,0)
                    local predictionFactor = 0.06
                    local predictedPos = targetHrp.Position + (targetVelocity * predictionFactor)
                    
                    local strictLockPos = predictedPos
                    
                    if AttackModeOption == "Xoay vòng đối thủ" then
                        OrbitAngle = OrbitAngle + (OrbitSpeed * dt)
                        local offsetX = math.cos(OrbitAngle) * OrbitRadius
                        local offsetZ = math.sin(OrbitAngle) * OrbitRadius
                        strictLockPos = predictedPos + Vector3.new(offsetX, 0.3, offsetZ)
                    else
                        local lookVector = targetHrp.CFrame.LookVector
                        strictLockPos = predictedPos - (lookVector * OrbitRadius) + Vector3.new(0, 0.3, 0)
                    end
                    
                    hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(strictLockPos, targetHrp.Position), 0.5)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

                    local currentDistToTarget = (hrp.Position - targetHrp.Position).Magnitude
                    if currentDistToTarget <= 40 then
                        -- Spam cắn liên tục không giới hạn độ trễ (RenderStepped tốc độ cao)
                        PerformAttack(targetChar)
                    end
                else
                    local escapePos = targetHrp.Position + Vector3.new(0, SafeHeight, 0)
                    -- Đã fix lỗi CForm -> CFrame tránh crash
                    hrp.CFrame = CFrame.new(escapePos, hrp.Position + hrp.CFrame.LookVector)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            else
                CurrentPersistentTarget = nil
            end
        else
            CurrentPersistentTarget = nil
        end
    end
end)
