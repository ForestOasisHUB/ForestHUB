local function spawnFallingParticle(icon)
    local particleLabel = Instance.new("TextLabel")
    particleLabel.Text = icon
    particleLabel.Size = UDim2.new(0, 18, 0, 18)
    particleLabel.BackgroundTransparency = 1
    particleLabel.TextSize = math.random(13, 17)
    particleLabel.ZIndex = 2
    
    local startX = math.random(5, 140)
    particleLabel.Position = UDim2.new(0, startX, 0, -20)
    particleLabel.Parent = EffectFrame
    
    local fallSpeed = math.random(25, 45)
    local fallConnection
    local currentY = -20
    local rot = math.random(0, 360)
    
    fallConnection = RunService.RenderStepped:Connect(function(dt)
        if not particleLabel.Parent then
            if fallConnection then fallConnection:Disconnect() end
            return
        end
        currentY = currentY + (dt * fallSpeed)
        rot = rot + (dt * 50)
        particleLabel.Position = UDim2.new(0, startX, 0, currentY)
        particleLabel.Rotation = rot
        if currentY > 65 then
            particleLabel:Destroy()
            if fallConnection then fallConnection:Disconnect() end
        end
    end)
end

