-- Hiệu ứng sọc sáng xoay tròn mượt mà quanh viền
local rotationAngle = 0
RunService.RenderStepped:Connect(function(dt)
    rotationAngle = (rotationAngle + dt * 250) % 360
    HolderGradient.Rotation = rotationAngle
end)

local dragging, dragInput, dragStart, startPos
ToggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = GlowHolder.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

ToggleBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        GlowHolder.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local autoSkyFarm = false
local platformPart = nil
local safePosition = nil
local antiFallConnection = nil
local speedJumpConnection = nil
local fullbrightConnection = nil

local function setFullbright(state)
    if state then
        Lighting.Brightness = 2
        Lighting.ClockTime = 12
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        
        fullbrightConnection = Lighting.Changed:Connect(function()
            if autoSkyFarm then
                Lighting.Brightness = 2
                Lighting.ClockTime = 12
                Lighting.GlobalShadows = false
                Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
            end
        end)
    else
        if fullbrightConnection then
            fullbrightConnection:Disconnect()
            fullbrightConnection = nil
        end
    end
end

local function createSkyPlatform()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if platformPart and platformPart.Parent then
        platformPart:Destroy()
    end

    local currentPos = hrp.Position
    safePosition = Vector3.new(currentPos.X, currentPos.Y + 800, currentPos.Z)

    platformPart = Instance.new("Part")
    platformPart.Name = "EvadeAFKPlatform"
    platformPart.Size = Vector3.new(35, 3, 35)
    platformPart.Position = safePosition - Vector3.new(0, 3, 0)
    platformPart.Anchored = true
    platformPart.BrickColor = BrickColor.new("Neon orange")
    platformPart.Material = Enum.Material.Neon
    platformPart.Parent = Workspace

    hrp.CFrame = CFrame.new(safePosition)
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
end

local function removeSkyPlatform()
    if platformPart and platformPart.Parent then
        platformPart:Destroy()
        platformPart = nil
    end
end

local function getActiveSpawnedItem()
    local bestTarget = nil
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj and obj.Parent then
            if obj:IsDescendantOf(Players) then continue end
            
            local name = string.lower(obj.Name)
            local pName = obj.Parent and string.lower(obj.Parent.Name) or ""
            
            local isItemCandidate = name:find("soul") or name:find("itemspawn") or name:find("eventitem") or 
                                    pName:find("soul") or pName:find("itemspawn")
            
            if isItemCandidate then
                local targetPart = nil
                if obj:IsA("BasePart") then
                    targetPart = obj
                elseif obj:IsA("Model") then
                    targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                end
                
                if targetPart then
                    local hasPrompt = targetPart:FindFirstChildWhichIsA("ProximityPrompt", true) or 
                                      (targetPart.Parent and targetPart.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
                    local hasTouch = targetPart:FindFirstChildWhichIsA("TouchTransmitter", true)
                    
                    local isSpawnedReal = (targetPart.Transparency < 0.85) or hasPrompt or hasTouch
                    
                    if isSpawnedReal then
                        bestTarget = targetPart
                        break
                    end
                end
            end
        end
    end
    
    return bestTarget
end

local function interactWithItem(targetPart)
    pcall(function()
        local prompt = targetPart:FindFirstChildWhichIsA("ProximityPrompt", true) or 
                       (targetPart.Parent and targetPart.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
        if prompt then
            fireproximityprompt(prompt)
        end
    end)
end

local function isSoulStillAlive(targetPart)
    if not targetPart or not targetPart.Parent then return false end
    if targetPart.Transparency >= 0.85 then return false end
    return true
end

-- LẮP ĐẶT HIỆU ỨNG VIỀN CAM SÁNG XOAY TRÒN CHO LÚC ON
ToggleBtn.MouseButton1Click:Connect(function()
    autoSkyFarm = not autoSkyFarm
    
    if autoSkyFarm then
        ToggleBtn.Text = "🎃 Evade Item Farm: ON 🔮"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 15, 5)
        
        -- Sọc màu cam tươi rực rỡ chạy quanh viền lúc ON
        HolderGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 140, 0)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 230, 150)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 140, 0))
        })
        
        setFullbright(true)
        createSkyPlatform()

        antiFallConnection = RunService.RenderStepped:Connect(function()
            if not autoSkyFarm or not safePosition then return end
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end)

        speedJumpConnection = RunService.Stepped:Connect(function()
            if not autoSkyFarm then return end
            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.WalkSpeed = 30
                humanoid.JumpPower = 80
            end
        end)

        task.spawn(function()
            while autoSkyFarm do
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if hrp and safePosition then
                    local targetPart = getActiveSpawnedItem()
                    
                    if targetPart then
                        local timeWaited = 0
                        local maxTimeout = 3.0
                        
                        while autoSkyFarm and isSoulStillAlive(targetPart) and timeWaited < maxTimeout do
                            if hrp and targetPart and targetPart.Parent then
                                hrp.CFrame = targetPart.CFrame + Vector3.new(0, 1, 0)
                                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                interactWithItem(targetPart)
                            end
                            task.wait(0.1)
                            timeWaited = timeWaited + 0.1
                        end
                        
                        if hrp and safePosition then
                            hrp.CFrame = CFrame.new(safePosition)
                            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        end
                        task.wait(0.2)
                    else
                        if hrp and safePosition then
                            hrp.CFrame = CFrame.new(safePosition)
                            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        end
                        task.wait(0.5)
                    end
                else
                    task.wait(1)
                end
            end
        end)
    else
        ToggleBtn.Text = "🎃 Evade Item Farm: OFF 👻"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(20, 15, 30)
        
        -- Khôi phục dải sọc trắng/xám lúc OFF
        HolderGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(120, 120, 120)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
        })
        
        setFullbright(false)
        
        if antiFallConnection then antiFallConnection:Disconnect() antiFallConnection = nil end
        if speedJumpConnection then speedJumpConnection:Disconnect() speedJumpConnection = nil end
        
        removeSkyPlatform()
    end
end)
