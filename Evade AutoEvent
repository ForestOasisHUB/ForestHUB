local function createSkyPlatform()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if platformPart and platformPart.Parent then platformPart:Destroy() end

    local baseWorldPos = hrp.Position
    safePosition = Vector3.new(baseWorldPos.X, baseWorldPos.Y + 1000, baseWorldPos.Z)

    -- Sàn hình vuông Neon Cam
    platformPart = Instance.new("Part")
    platformPart.Name = "FixedSafePlatform"
    platformPart.Shape = Enum.PartType.Block
    platformPart.Size = Vector3.new(35, 2, 35)
    platformPart.Position = safePosition - Vector3.new(0, 2, 0)
    platformPart.Anchored = true
    platformPart.BrickColor = BrickColor.new("Neon orange")
    platformPart.Material = Enum.Material.Neon
    platformPart.Parent = Workspace

    -- Viền sáng Neon Cam bao quanh
    local glowBorder = Instance.new("SelectionBox")
    glowBorder.Adornee = platformPart
    glowBorder.Color3 = Color3.fromRGB(255, 140, 0)
    glowBorder.LineThickness = 0.1
    glowBorder.Parent = platformPart

    hrp.CFrame = CFrame.new(safePosition)
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
end

local function removeSkyPlatform()
    if platformPart and platformPart.Parent then
        platformPart:Destroy()
        platformPart = nil
    end
end

local function getActiveSpawnedItem()
    local bestTarget = nil
    local detectedName = "Soul"
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isValidSoul(obj) then
            local targetPart = obj:IsA("BasePart") and obj or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")))
            if targetPart and (targetPart.Transparency < 0.85 or targetPart:FindFirstChildWhichIsA("ProximityPrompt", true)) then
                bestTarget = targetPart
                detectedName = obj.Name
                break
            end
        end
    end
    return bestTarget, detectedName
end

local function interactWithItem(targetPart)
    pcall(function()
        local prompt = targetPart:FindFirstChildWhichIsA("ProximityPrompt", true) or (targetPart.Parent and targetPart.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
        if prompt then fireproximityprompt(prompt) end
    end)
end

local function isSoulStillAlive(targetPart)
    if not targetPart or not targetPart.Parent then return false end
    if targetPart.Transparency >= 0.85 then return false end
    return true
end

