-- TÍNH ĐÚNG ĐIỂM SOUL (LV3 = 10, LV2 = 4, LV1 = 1)
local function getSoulPoints(targetPart, rawName)
    local fullString = string.lower(rawName or "")
    if targetPart then
        fullString = fullString .. " " .. string.lower(targetPart.Name)
        local p = targetPart.Parent
        while p and p ~= Workspace do
            fullString = fullString .. " " .. string.lower(p.Name)
            p = p.Parent
        end
    end

    if fullString:find("level3") or fullString:find("3") then
        return 10
    elseif fullString:find("level2") or fullString:find("2") then
        return 4
    elseif fullString:find("level1") or fullString:find("1") then
        return 1
    end

    return 1
end

local function updateStatsDisplay()
    if not autoSkyFarm then return end
    
    local currentActiveTime = accumulatedTime + (tick() - lastActiveTick)
    local hours = math.floor(currentActiveTime / 3600)
    local minutes = math.floor((currentActiveTime % 3600) / 60)
    local seconds = math.floor(currentActiveTime % 60)
    local timeStr = string.format("%02d:%02d:%02d", hours, minutes, seconds)
    
    StatsContent.Text = string.format("TIME: %s | SOUL: %d\nFPS: %d | PING: %dms", timeStr, totalSoulPoints, currentFPS, getPing())
end

